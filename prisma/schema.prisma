generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String?  @unique
  passwordHash   String?
  name           String?
  image          String?
  role           String   @default("GUEST")
  creditsBalance Int      @default(5)
  storageUsed    BigInt   @default(0)
  storageLimit   BigInt   @default(1073741824)
  maxProjects    Int?
  isSuspended    Boolean  @default(false)
  suspendedReason String?
  adminNotes     String?
  lastLoginIp    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastActiveAt   DateTime @default(now())

  projects     Project[]
  files        ProjectFile[]
  aiUsageLogs  AiUsageLog[]
  subscription Subscription?
  purchaseRequests CreditPurchaseRequest[]
  creditSpends    CreditSpendLog[]
  collaborations ProjectCollaborator[]
  comments        Comment[]
  activities      ProjectActivity[]
  presence        UserPresence?
  apiKeys         ApiKey[]
  ownedWorkspaces Workspace[]
  workspaceMemberships WorkspaceMember[]
  authoredTemplates CommunityTemplate[]
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  plan                 String   @default("FREE")
  status               String   @default("ACTIVE")
  periodStart          DateTime @default(now())
  periodEnd            DateTime
  creditsMonthly       Int      @default(5)
  creditsUsedThisMonth Int      @default(0)
  stripeCustomerId     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id           String   @id @default(uuid())
  userId       String
  name         String
  description  String?
  type         String   @default("video")
  status       String   @default("DRAFT")
  size         BigInt   @default(0)
  thumbnailUrl String?
  metadata     Json     @default("{}")
  isShared     Boolean  @default(false)
  shareLink    String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  files        ProjectFile[]
  collaborators ProjectCollaborator[]
  comments     Comment[]
  activities   ProjectActivity[]
}

model ProjectCollaborator {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("editor")
  invitedAt DateTime @default(now())
  acceptedAt DateTime?
  invitedBy String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  content   String
  timeCode  Float?
  resolved  Boolean  @default(false)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
}

model ProjectActivity {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  action    String
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPresence {
  id         String   @id @default(uuid())
  userId     String   @unique
  projectId  String?
  lastActive DateTime @default(now())
  cursorPos  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProjectFile {
  id           String    @id @default(uuid())
  projectId    String?
  userId       String
  category     String    @default("RAW")
  storagePath  String
  originalName String
  mimeType     String
  size         BigInt
  width        Int?
  height       Int?
  duration     Float?
  autoDeleteAt DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AutoDeleteConfig {
  id                String   @id @default(uuid())
  role              String   @unique
  tempTtlHours      Int      @default(1)
  processedTtlHours Int      @default(24)
  exportTtlHours    Int      @default(168)
  enabled           Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model FeatureToggle {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  enabled   Boolean  @default(false)
  roles     String   @default("[\"ADMIN\"]")
  updatedAt DateTime @updatedAt
}

model AiUsageLog {
  id         String   @id @default(uuid())
  userId     String?
  feature    String
  provider   String
  modelName  String?
  tokensUsed Int?
  cost       Float    @default(0)
  durationMs Int?
  success    Boolean  @default(true)
  errorMsg   String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  severity  String   @default("info")
  isActive  Boolean  @default(true)
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  createdAt DateTime @default(now())
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  label     String
  category  String   @default("general")
  type      String   @default("string")
  updatedAt DateTime @updatedAt
}

model BankDetail {
  id          String   @id @default(uuid())
  accountName String
  accountNo   String
  bankName    String
  isActive    Boolean  @default(true)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CreditPackage {
  id            String   @id @default(uuid())
  name          String
  credits       Int
  priceNaira    Int
  bonusCredits  Int      @default(0)
  description   String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requests CreditPurchaseRequest[]
}

model CreditPurchaseRequest {
  id            String   @id @default(uuid())
  userId        String
  packageId     String?
  credits       Int
  amountNaira   Int
  accountName   String
  accountNo     String?
  bankName      String?
  reference     String?
  status        String   @default("PENDING")
  adminNotes    String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  package CreditPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
}

model CreditSpendLog {
  id        String   @id @default(uuid())
  userId    String
  feature   String
  credits   Int
  reason    String?
  balance   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RateLimit {
  id          String   @id @default(uuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
}

model JobQueue {
  id          String    @id @default(uuid())
  type        String
  payload     Json      @default("{}")
  status      String    @default("PENDING")
  priority    Int       @default(0)
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  retryCount  Int       @default(0)
  maxRetries  Int       @default(3)
  createdAt   DateTime  @default(now())
}

model ApiKey {
  id        String    @id @default(uuid())
  userId    String
  name      String
  key       String    @unique
  scopes    String    @default("[\"read\"]")
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String            @id @default(uuid())
  name      String
  ownerId   String
  plan      String            @default("FREE")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  owner   User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members WorkspaceMember[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        String   @default("MEMBER")
  storageUsed BigInt   @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model CommunityTemplate {
  id           String   @id @default(uuid())
  name         String
  description  String?
  thumbnailUrl String?
  trackData    Json
  authorId     String
  isPublic     Boolean  @default(true)
  usageCount   Int      @default(0)
  likes        Int      @default(0)
  category     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
